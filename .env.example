# ── Web (apps/web) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never expose to client
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Mobile (apps/mobile) — EXPO_PUBLIC_ prefix is bundled into the app ──
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=      # anon key only — NEVER the service role key in mobile
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# ── Provider dashboard E2E (Playwright, P01) ──
# The seeded dev receptionist. Never commit the real value — the tests skip
# cleanly when these are unset.
PROVIDER_TEST_EMAIL=
PROVIDER_TEST_PASSWORD=

# ── Shared server-side (Edge Functions / API routes) ──
# Payments: PayTabs (decision changed from Paymob). NO account exists yet —
# the legal entity is pending — so F06 ships MockPaymentProvider and these stay
# empty. Server Key is SERVER-ONLY: it must never gain an EXPO_PUBLIC_ prefix.
PAYTABS_PROFILE_ID=                 # added at F06 (unset — mock provider in use)
PAYTABS_SERVER_KEY=                 # server-only, never in the mobile bundle
PAYTABS_CLIENT_KEY=
PAYTABS_BASE_URL=                   # e.g. https://secure-egypt.paytabs.com
VONAGE_API_KEY=                     # SMS — added at F01
VONAGE_API_SECRET=
VONAGE_FROM=InstaHealth

# ── Analytics (added later) ──
NEXT_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=

# ── Admin fidelity capture harness (Playwright, local authoring tool) ──
# A DEDICATED dev-only admin so `fidelity.spec.ts` can reach an aal2 session and
# capture the A04–A07 screens. It signs in through the REAL login form — the
# secret below is an AUTHENTICATOR, not a bypass. Seeded by
# supabase/seeds/007_admin_fidelity_account.sql; DEV ONLY, never production.
# ⚠ The TOTP secret is a CREDENTIAL. Never commit a value — the repo is public.
# These captures are `testIgnore`d under CI, so CI does not need them set.
FIDELITY_ADMIN_EMAIL=                # must be admin-fidelity@instahealth.eg
FIDELITY_ADMIN_PASSWORD=
FIDELITY_ADMIN_TOTP_SECRET=          # base32, 32 chars
